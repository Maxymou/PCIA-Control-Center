{
  "name": "pcia-control-center",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "tsc -b && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "preview": "vite preview",
    "server": "node dist-server/server/src/index.js",
    "server:dev": "tsx watch server/src/index.ts",
    "fand": "node dist-server/server/src/fand.js",
    "fand:dev": "tsx server/src/fand.ts",
    "cli": "node dist-server/server/src/cli.js",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.3.0",
    "@xyflow/react": "^12.4.4",
    "better-sqlite3": "^13.0.2",
    "fastify": "^5.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.10"
  }
}

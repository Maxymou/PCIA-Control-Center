[Unit]
Description=PCIA Control Center — interface, API et supervision
Documentation=https://github.com/Maxymou/PCIA-Control-Center
After=network-online.target pcia-fan-control.service
Wants=network-online.target
# Volontairement `Wants` et non `Requires` : si le moteur de ventilation est
# arrêté, l'interface doit rester accessible pour le signaler.
Wants=pcia-fan-control.service

# Limitation des redémarrages en boucle. Ces deux directives appartiennent à
# [Unit] : placées dans [Service], systemd les ignore avec un avertissement.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=pcia
Group=pcia
WorkingDirectory=/opt/pcia-control-center
Environment=NODE_ENV=production
Environment=PCIA_CONFIG=/etc/pcia-control-center/config.yaml
EnvironmentFile=-/etc/pcia-control-center/env
ExecStart=/usr/bin/node /opt/pcia-control-center/dist-server/server/src/index.js

Restart=on-failure
RestartSec=3

KillSignal=SIGTERM
TimeoutStopSec=20

ReadWritePaths=/var/lib/pcia-control-center /run/pcia-control-center
# /run/pcia-control-center est PARTAGÉ avec pcia-fan-control.service (socket
# IPC, verrou, fichier d'état). Sans RuntimeDirectoryPreserve, l'arrêt de l'un
# des deux services supprime le répertoire encore utilisé par l'autre, qui
# échoue ensuite sur « EACCES: permission denied, mkdir ».
RuntimeDirectory=pcia-control-center
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=pcia-control-center
StateDirectoryMode=0750

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
# AF_NETLINK est indispensable : os.networkInterfaces(), utilisé par Fastify au
# démarrage, interroge le noyau via Netlink (uv_interface_addresses). Sans lui,
# Node.js échoue avec « ERR_SYSTEM_ERROR: uv_interface_addresses returned
# Unknown system error 97 ». Le daemon de ventilation n'en a pas besoin.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

StandardOutput=journal
StandardError=journal
SyslogIdentifier=pcia-control-center

[Install]
WantedBy=multi-user.target
